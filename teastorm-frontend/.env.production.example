# =============================================================================
# TeaStorm — Production Environment Variables
# =============================================================================
# Copy this file to .env.local (or set these in your hosting provider's dashboard).
# Never commit real secrets to source control.
# =============================================================================

# --- Database (Supabase / PostgreSQL) ----------------------------------------
# Full connection string including password.
# Use the "Transaction" pooler URL from Supabase dashboard for serverless.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# --- Stripe ------------------------------------------------------------------
# Secret key — stays server-side only. Never expose to the client.
STRIPE_SECRET_KEY=sk_live_...

# Publishable key — safe to expose to the browser via NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret from Stripe Dashboard → Webhooks.
# Required for verifying incoming webhook events.
STRIPE_WEBHOOK_SECRET=whsec_...

# Shipping rate ID from your Stripe account.
STRIPE_SHIPPING_RATE_ID=shr_...

# --- Application URL ---------------------------------------------------------
# The canonical public URL of your deployed app (no trailing slash).
# Used to build Stripe success/cancel redirect URLs.
# Example: https://teastorm.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- NextAuth ----------------------------------------------------------------
# Must match the deployed app URL exactly (including protocol, no trailing slash).
NEXTAUTH_URL=https://your-domain.com

# A long random secret string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-secure-random-value

# --- Email (Nodemailer SMTP) -------------------------------------------------
# Required for order confirmation and admin notification emails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=orders@your-domain.com

# Admin email that receives new order notifications.
ADMIN_EMAIL=admin@your-domain.com

# --- Prisma ------------------------------------------------------------------
# Keep as "binary" unless you are using a custom query engine.
PRISMA_CLIENT_ENGINE_TYPE=binary
